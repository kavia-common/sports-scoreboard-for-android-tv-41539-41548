<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- TV: leanback feature optional to allow emulator/device flexibility -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SportsTV">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:banner="@drawable/banner"
            android:logo="@mipmap/ic_launcher"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Note: Place google-services.json in this module at:
             sports-scoreboard-for-android-tv-41539-41548/android_tv_frontend/app/google-services.json -->
    </application>
</manifest>
