<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/matchListFragment">

    <fragment
        android:id="@+id/matchListFragment"
        android:name="org.example.app.ui.MatchListFragment"
        android:label="@string/matches_title">
        <action
            android:id="@+id/action_matchList_to_matchDetail"
            app:destination="@id/matchDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/matchDetailFragment"
        android:name="org.example.app.ui.MatchDetailFragment"
        android:label="Match Details">
        <argument
            android:name="matchId"
            app:argType="string" />
    </fragment>
</navigation>
