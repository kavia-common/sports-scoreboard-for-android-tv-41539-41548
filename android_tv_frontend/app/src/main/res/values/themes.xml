<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SportsTV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ocean_primary</item>
        <item name="colorSecondary">@color/ocean_secondary</item>
        <item name="android:colorBackground">@color/ocean_background</item>
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Define the generic Widget root to avoid style/Widget resolution errors -->
    <style name="Widget"/>

    <!-- Namespace for our app widgets -->
    <style name="Widget.SportsTV" />

    <!-- Card style used by item_match_card; keeps Ocean Professional visuals -->
    <style name="Widget.SportsTV.Card">
        <item name="android:background">@color/ocean_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
</resources>
